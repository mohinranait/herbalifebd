// use prisma-8

model Category {
  id          ObjectId           @id @map("_id")
  name        String
  slug        String             @unique
  parentId    ObjectId?
  parent      Category?          @relation(fields: [parentId], references: [id])
  thumbnail   String?
  banner      String?
  description String?
  level       Int32?
  path        String[]
  status      Bool?
  priority    Int32?
  isDelete    Bool?
  createdAt   temporal.CreatedAt
  updatedAt   temporal.UpdatedAt

  @@index([status, isDelete, priority])
  @@index([parentId])
  @@map("categories")
}
