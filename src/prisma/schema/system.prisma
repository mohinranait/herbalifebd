// use prisma-8

model Media {
  id         ObjectId           @id @map("_id")
  fileUrl    String?
  width      Int32?
  height     Int32?
  extension  String?
  public_id  String?
  secure_url String?
  size       Int32?
  createdAt  temporal.CreatedAt
  updatedAt  temporal.UpdatedAt

  @@index([createdAt])
  @@index([public_id])
  @@map("media")
}

model AppSetting {
  id                 ObjectId           @id @map("_id")
  siteName           String?
  siteDescription    String?
  logo               String?
  footerLogo         String?
  favicon            String?
  themeColor         String?
  contactEmail       String?
  contactPhone       String?
  address            Json?
  metaTitle          String?
  metaDescription    String?
  metaKeyword        String?
  ogImage            String?
  marque             String?
  currency           Json?
  language           String?
  timezone           String?
  paymentMethods     Json?
  shipping           Json?
  socialLinks        Json?
  features           Json?
  layouts            Json?
  maintenanceMode    Bool?
  maintenanceMessage String?
  tax                Json?
  customCss          String?
  customJs           String?
  orderStatusConfig  Json?
  createdAt          temporal.CreatedAt
  updatedAt          temporal.UpdatedAt

  @@map("app_settings")
}

model AppConfig {
  id         ObjectId           @id @map("_id")
  email      Json?
  cloudinary Json?
  createdAt  temporal.CreatedAt
  updatedAt  temporal.UpdatedAt

  @@map("app_configs")
}

model Expense {
  id        ObjectId           @id @map("_id")
  title     String
  category  String?
  amount    Double
  date      Date
  note      String?
  createdAt temporal.CreatedAt
  updatedAt temporal.UpdatedAt

  @@index([date])
  @@map("expenses")
}
