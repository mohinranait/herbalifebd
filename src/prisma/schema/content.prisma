// use prisma-8

model Comment {
  id         ObjectId           @id @map("_id")
  productId  ObjectId
  product    Product            @relation(fields: [productId], references: [id])
  userId     ObjectId
  user       User               @relation(fields: [userId], references: [id])
  comment    String
  rating     Int32?
  isApproved Bool?
  isFeature  Bool?
  createdAt  temporal.CreatedAt
  updatedAt  temporal.UpdatedAt

  @@index([productId, isApproved, createdAt])
  @@index([userId, createdAt])
  @@map("comments")
}

model Contact {
  id          ObjectId           @id @map("_id")
  fullName    String?
  email       String?
  phone       String?
  orderNumber String?
  subject     String?
  message     String?
  createdAt   temporal.CreatedAt
  updatedAt   temporal.UpdatedAt

  @@map("contacts")
}

model Faq {
  id        ObjectId           @id @map("_id")
  title     String?
  contents  String[]
  priority  Int32?
  status    Bool?
  createdAt temporal.CreatedAt
  updatedAt temporal.UpdatedAt

  @@map("faqs")
}

model Slider {
  id          ObjectId           @id @map("_id")
  title       String
  description String?
  link        String?
  buttonName  String?
  sliderType  String?
  image       String?
  status      Bool?
  order       Int32?
  isDelete    Bool?
  createdAt   temporal.CreatedAt
  updatedAt   temporal.UpdatedAt

  @@index([status, isDelete, order])
  @@map("sliders")
}

model SiteContent {
  id                  ObjectId           @id @map("_id")
  companyIntroduction Json?
  whyChooseUs         Json?
  createdAt           temporal.CreatedAt
  updatedAt           temporal.UpdatedAt

  @@map("site_contents")
}

model SiteTranslation {
  id        ObjectId           @id @map("_id")
  content   Json?
  createdAt temporal.CreatedAt
  updatedAt temporal.UpdatedAt

  @@map("site_translations")
}
